.incbin "@qemu_kernel@"
qemu_guest_image_end:
.balign 16
.global qemu_guest_initrd_start
.global qemu_guest_initrd_end
qemu_guest_initrd_start:
.incbin "@qemu_initrd@"
qemu_guest_initrd_end:
