menuconfig ARM64_HYPERVISOR
	bool "Native AArch64 guest executor"
	depends on ARM64_EL2 && ARM_MMU && GIC_V3 && FPU_SHARING
	help
	  Execute one AArch64 guest with Stage-2 isolation. Devices and
	  instruction exits are handled by an external device model.

if ARM64_HYPERVISOR

config ARM64_HYPERVISOR_RAM_SIZE_MIB
	int "Reserved guest RAM size in MiB"
	default 256
	range 2 3072
	help
	  Statically reserve a contiguous area aligned to 2 MiB. The size must
	  be even and the board must provide enough RAM for both host and guest.

config ARM64_HYPERVISOR_IPA_BITS
	int "Guest physical address width"
	default 32
	range 32 36
	help
	  Increase the guest physical address range when a memory-mapped image
	  lives above the guest's main RAM. Stage-2 tables cover this range.

config ARM64_HYPERVISOR_GIC_LR_IRQS
	bool "Use GIC List Registers for virtual interrupt lines"
	help
	  Signal the external device model's IRQ and FIQ lines with two GIC
	  virtual List Registers. CPU-interface accesses remain trapped, so
	  interrupt acknowledgement and priority belong to the device model.
	  Supports nested hypervisors that do not implement HCR VI/VF injection.

endif # ARM64_HYPERVISOR
