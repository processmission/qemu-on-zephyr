<?xml version="1.0"?>
<JWM>
    <RootMenu onroot="12">
        <Program label="Terminal">xterm</Program>
        <Program label="Clock">xclock</Program>
        <Exit label="Exit desktop" confirm="false"/>
    </RootMenu>
    <WindowStyle>
        <Font>DejaVu Sans-10</Font>
        <Width>3</Width><Height>26</Height>
        <Foreground>#dce7f4</Foreground><Background>#243650</Background>
        <Active><Foreground>#ffffff</Foreground><Background>#315879</Background></Active>
    </WindowStyle>
    <TrayStyle>
        <Font>DejaVu Sans-10</Font>
        <Foreground>#dce7f4</Foreground><Background>#243650</Background>
    </TrayStyle>
    <Tray x="0" y="-1" height="34">
        <TrayButton label="Alpine Linux">root:1</TrayButton>
        <TaskList maxwidth="260"/>
        <Clock format="%H:%M:%S"/>
    </Tray>
    <Desktops width="1" height="1"><Background type="solid">#182337</Background></Desktops>
    <FocusModel>click</FocusModel>
</JWM>
